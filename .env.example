# ---------- Database (Supabase, NEW dedicated project) ----------
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
# Database password (any characters OK — the app inserts and encodes it into DATABASE_URL)
DATABASE_PASSWORD=
DATABASE_POOL_MAX=3

# ---------- Admin login & secrets (generate, never commit) ----------
ADMIN_PASSWORD=change-me-to-a-long-password
# openssl rand -base64 48
SESSION_SECRET=
# 32 random bytes, base64:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ---------- TradingView ----------
# openssl rand -hex 24   → also put this value in the alert JSON "secret" field
TRADINGVIEW_WEBHOOK_SECRET=
# true = only accept TradingView's published IPs (verify the list in src/lib/server/config.ts first)
TRADINGVIEW_ENFORCE_IP_ALLOWLIST=false

# ---------- Telegram ----------
# Recommended: keep the token in env. (Alternatively save it in Settings: stored AES-256-GCM encrypted.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public https URL of the deployed site (used for "Buka Chart"/"Lihat Replay" buttons)
APP_BASE_URL=https://your-app.vercel.app
