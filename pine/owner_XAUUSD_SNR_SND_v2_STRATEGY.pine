//@version=6
strategy("XAUUSD SNR + SND v2 | STRATEGY | RR 1:2", overlay = true, initial_capital = 10000, currency = currency.USD, pyramiding = 0, process_orders_on_close = true, commission_type = strategy.commission.cash_per_contract, commission_value = 0, slippage = 0, max_labels_count = 30)

// ================= INPUT =================
gTrend = "01 | Arah tren H4"
fastLen = input.int(50, "EMA cepat", minval = 2, group = gTrend)
slowLen = input.int(200, "EMA lambat", minval = 5, group = gTrend)
pivotLen = input.int(3, "Pivot H4 kiri/kanan", minval = 1, maxval = 10, group = gTrend)
requireStructure = input.bool(false, "Wajib HH+HL untuk BUY / LH+LL untuk SELL", group = gTrend)

gZone = "02 | Zona SND H4 + H1"
impulseATR = input.float(0.8, "Minimum body displacement / ATR", minval = 0.2, step = 0.1, group = gZone)
structureBreak = input.int(5, "Break struktur sebelum displacement", minval = 2, maxval = 30, group = gZone)
maxTouches = input.int(2, "Maksimum sentuhan setelah zona terbentuk", minval = 1, maxval = 10, group = gZone)
maxAge4 = input.int(90, "Umur maksimal zona H4 (bar H4)", minval = 5, group = gZone)
maxAge1 = input.int(120, "Umur maksimal zona H1 (bar H1)", minval = 5, group = gZone)
useSNR = input.bool(false, "Wajib dekat SNR H4 (lebih ketat)", group = gZone)
snrATR = input.float(1.0, "Radius SNR H4 / ATR H4", minval = 0.1, step = 0.1, group = gZone)
proximityATR = input.float(0.5, "Toleransi dekat zona / ATR M15", minval = 0, step = 0.1, group = gZone)

gEntry = "03 | Entry M15"
mode = input.string("Semua", "Mode pola entry", options = ["Semua", "Rejection", "Sweep", "Break-Retest"], group = gEntry)
closeStrength = input.float(0.70, "Posisi close minimum di arah sinyal", minval = 0.50, maxval = 0.95, step = 0.05, group = gEntry)
wickBodyMin = input.float(0.60, "Wick reversal / body minimum", minval = 0.10, maxval = 4.0, step = 0.1, group = gEntry)
sweepLookback = input.int(8, "Lookback sweep (bar M15)", minval = 3, maxval = 50, group = gEntry)
breakLookback = input.int(12, "Lookback breakout struktur M15", minval = 3, maxval = 50, group = gEntry)
retestBars = input.int(8, "Batas waktu retest (bar M15)", minval = 1, maxval = 40, group = gEntry)
retestTolerance = input.float(0.25, "Toleransi retest / ATR M15", minval = 0.0, step = 0.05, group = gEntry)
slBufferATR = input.float(0.15, "Buffer SL / ATR M15", minval = 0, step = 0.05, group = gEntry)
maxStopATR = input.float(4.0, "Maksimum jarak SL / ATR M15", minval = 0.5, step = 0.25, group = gEntry)
cooldownBars = input.int(8, "Jeda sinyal (bar M15)", minval = 0, group = gEntry)
float rr = 2.0 // Dikunci: RR 1:2

gTime = "04 | Sesi dan risiko"
useSession = input.bool(false, "Batasi sesi perdagangan (UTC)", group = gTime)
sessionUTC = input.session("0700-2100", "Jam aktif (UTC)", group = gTime)
riskUSD = input.float(10.0, "Risiko acuan USD", minval = 0.1, step = 1.0, group = gTime)
ozPerLot = input.float(100.0, "Ons per 1 lot (sesuaikan broker)", minval = 0.1, group = gTime)
minLot = input.float(0.01, "Minimum lot broker", minval = 0.001, group = gTime)
lotStep = input.float(0.01, "Step lot broker", minval = 0.001, group = gTime)
maxHoldBars = input.int(96, "Tutup posisi setelah N candle M15 (strategy)", minval = 8, group = gTime)

if timeframe.period != "15"
    runtime.error("Pasang indikator/strategy pada chart M15. H4 dan H1 diambil otomatis.")

// ================= H4/H1: ZONA KONFIRMASI =================
// Semua elemen request.security dikembalikan dengan offset [1] dan lookahead_on.
// Zona = candle berlawanan sebelum displacement yang menembus struktur sebelumnya.
// Freshness = umur + jumlah peristiwa sentuhan; invalid jika CLOSE menembus sisi luar.
f_htf(int ageLimit) =>
    float atr = ta.atr(14)
    float ph = ta.pivothigh(high, pivotLen, pivotLen)
    float pl = ta.pivotlow(low, pivotLen, pivotLen)
    float resistance = ta.valuewhen(not na(ph), ph, 0)
    float support = ta.valuewhen(not na(pl), pl, 0)
    float prevPH = ta.valuewhen(not na(ph), ph, 1)
    float prevPL = ta.valuewhen(not na(pl), pl, 1)
    bool hhhl = not na(resistance) and not na(prevPH) and not na(support) and not na(prevPL) and resistance > prevPH and support > prevPL
    bool lhll = not na(resistance) and not na(prevPH) and not na(support) and not na(prevPL) and resistance < prevPH and support < prevPL
    float upperBreak = ta.highest(high, structureBreak)[1]
    float lowerBreak = ta.lowest(low, structureBreak)[1]
    bool bullImpulse = close > open and close[1] < open[1] and close - open >= atr * impulseATR and close > upperBreak
    bool bearImpulse = close < open and close[1] > open[1] and open - close >= atr * impulseATR and close < lowerBreak

    var float dLo = na
    var float dHi = na
    var float sLo = na
    var float sHi = na
    var int dBorn = na
    var int sBorn = na
    var int dTouches = 0
    var int sTouches = 0
    var bool dWasTouching = false
    var bool sWasTouching = false

    if not na(dLo)
        bool dOverlap = low <= dHi and high >= dLo
        if bar_index > dBorn and dOverlap and not dWasTouching
            dTouches += 1
        dWasTouching := dOverlap
        if close < dLo or bar_index - dBorn > ageLimit or dTouches > maxTouches
            dLo := na
            dHi := na
            dBorn := na
            dTouches := 0
            dWasTouching := false
    if not na(sHi)
        bool sOverlap = high >= sLo and low <= sHi
        if bar_index > sBorn and sOverlap and not sWasTouching
            sTouches += 1
        sWasTouching := sOverlap
        if close > sHi or bar_index - sBorn > ageLimit or sTouches > maxTouches
            sLo := na
            sHi := na
            sBorn := na
            sTouches := 0
            sWasTouching := false

    if bullImpulse
        dLo := low[1]
        dHi := open[1]
        dBorn := bar_index
        dTouches := 0
        dWasTouching := false
    if bearImpulse
        sLo := open[1]
        sHi := high[1]
        sBorn := bar_index
        sTouches := 0
        sWasTouching := false

    float ef = ta.ema(close, fastLen)
    float es = ta.ema(close, slowLen)
    [resistance[1], support[1], dLo[1], dHi[1], sLo[1], sHi[1], ef[1], es[1], close[1], atr[1], hhhl[1], lhll[1]]

[r4, sup4, d4lo, d4hi, s4lo, s4hi, emaF4, emaS4, c4, atr4, hhhl4, lhll4] = request.security(syminfo.tickerid, "240", f_htf(maxAge4), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[_r1, _sup1, d1lo, d1hi, s1lo, s1hi, _emaF1, _emaS1, _c1, _atr1, _hhhl1, _lhll1] = request.security(syminfo.tickerid, "60", f_htf(maxAge1), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

bool bullTrend = not na(emaS4) and emaF4 > emaS4 and c4 > emaF4 and (not requireStructure or hhhl4)
bool bearTrend = not na(emaS4) and emaF4 < emaS4 and c4 < emaF4 and (not requireStructure or lhll4)

// ================= GRAFIK LEVEL =================
plot(r4, "Resistance H4", color = color.new(color.red, 18), linewidth = 2, style = plot.style_stepline)
plot(sup4, "Support H4", color = color.new(color.lime, 18), linewidth = 2, style = plot.style_stepline)
d4a = plot(d4lo, "Demand H4 bawah", color = color.new(color.green, 50), style = plot.style_linebr)
d4b = plot(d4hi, "Demand H4 atas", color = color.new(color.green, 50), style = plot.style_linebr)
fill(d4a, d4b, color = color.new(color.green, 85), title = "Demand H4")
s4a = plot(s4lo, "Supply H4 bawah", color = color.new(color.red, 50), style = plot.style_linebr)
s4b = plot(s4hi, "Supply H4 atas", color = color.new(color.red, 50), style = plot.style_linebr)
fill(s4a, s4b, color = color.new(color.red, 85), title = "Supply H4")
d1a = plot(d1lo, "Demand H1 bawah", color = color.new(color.teal, 55), style = plot.style_linebr)
d1b = plot(d1hi, "Demand H1 atas", color = color.new(color.teal, 55), style = plot.style_linebr)
fill(d1a, d1b, color = color.new(color.teal, 89), title = "Demand H1")
s1a = plot(s1lo, "Supply H1 bawah", color = color.new(color.orange, 55), style = plot.style_linebr)
s1b = plot(s1hi, "Supply H1 atas", color = color.new(color.orange, 55), style = plot.style_linebr)
fill(s1a, s1b, color = color.new(color.orange, 89), title = "Supply H1")

// ================= SETUP M15 =================
float atr15 = ta.atr(14)
float candleSize = math.max(high - low, syminfo.mintick)
float body = math.max(math.abs(close - open), syminfo.mintick)
float lowerWick = math.min(open, close) - low
float upperWick = high - math.max(open, close)
bool strongBuy = close > open and (close - low) / candleSize >= closeStrength
bool strongSell = close < open and (high - close) / candleSize >= closeStrength

// Zona dipilih menggunakan zona terdekat yang bersinggungan/berdekatan dengan candle.
bool nearD4 = not na(d4lo) and low <= d4hi + atr15 * proximityATR and high >= d4lo and close > d4lo
bool nearD1 = not na(d1lo) and low <= d1hi + atr15 * proximityATR and high >= d1lo and close > d1lo
bool nearS4 = not na(s4hi) and high >= s4lo - atr15 * proximityATR and low <= s4hi and close < s4hi
bool nearS1 = not na(s1hi) and high >= s1lo - atr15 * proximityATR and low <= s1hi and close < s1hi
float buyBase = nearD4 and nearD1 ? math.max(d4lo, d1lo) : nearD1 ? d1lo : nearD4 ? d4lo : na
float sellCap = nearS4 and nearS1 ? math.min(s4hi, s1hi) : nearS1 ? s1hi : nearS4 ? s4hi : na
bool zoneBuyOK = not na(buyBase)
bool zoneSellOK = not na(sellCap)
bool snrBuyOK = not useSNR or (not na(sup4) and math.abs(close - sup4) <= atr4 * snrATR)
bool snrSellOK = not useSNR or (not na(r4) and math.abs(close - r4) <= atr4 * snrATR)

// Pola 1: penolakan jelas dari zona.
bool rejBuy = zoneBuyOK and strongBuy and lowerWick >= body * wickBodyMin
bool rejSell = zoneSellOK and strongSell and upperWick >= body * wickBodyMin

// Pola 2: sweep high/low lokal dan ditutup kembali melewati level tersapu.
float prevLow = ta.lowest(low, sweepLookback)[1]
float prevHigh = ta.highest(high, sweepLookback)[1]
bool sweepBuy = zoneBuyOK and strongBuy and low < prevLow and close > prevLow
bool sweepSell = zoneSellOK and strongSell and high > prevHigh and close < prevHigh

// Pola 3: breakout struktur, kemudian retest dari sisi yang sudah ditembus.
float breakHigh = ta.highest(high, breakLookback)[1]
float breakLow = ta.lowest(low, breakLookback)[1]
var float pendingLongLevel = na
var float pendingShortLevel = na
var int pendingLongBar = na
var int pendingShortBar = na
if close > breakHigh and close[1] <= breakHigh and strongBuy and bullTrend
    pendingLongLevel := breakHigh
    pendingLongBar := bar_index
if close < breakLow and close[1] >= breakLow and strongSell and bearTrend
    pendingShortLevel := breakLow
    pendingShortBar := bar_index
if not na(pendingLongBar) and bar_index - pendingLongBar > retestBars
    pendingLongLevel := na
    pendingLongBar := na
if not na(pendingShortBar) and bar_index - pendingShortBar > retestBars
    pendingShortLevel := na
    pendingShortBar := na
bool retestBuy = zoneBuyOK and not na(pendingLongBar) and bar_index > pendingLongBar and low <= pendingLongLevel + atr15 * retestTolerance and close > pendingLongLevel and strongBuy
bool retestSell = zoneSellOK and not na(pendingShortBar) and bar_index > pendingShortBar and high >= pendingShortLevel - atr15 * retestTolerance and close < pendingShortLevel and strongSell
if retestBuy or (not na(pendingLongLevel) and close < pendingLongLevel - atr15 * retestTolerance)
    pendingLongLevel := na
    pendingLongBar := na
if retestSell or (not na(pendingShortLevel) and close > pendingShortLevel + atr15 * retestTolerance)
    pendingShortLevel := na
    pendingShortBar := na

bool allowRej = mode == "Semua" or mode == "Rejection"
bool allowSweep = mode == "Semua" or mode == "Sweep"
bool allowRetest = mode == "Semua" or mode == "Break-Retest"
bool longPattern = (allowSweep and sweepBuy) or (allowRetest and retestBuy) or (allowRej and rejBuy)
bool shortPattern = (allowSweep and sweepSell) or (allowRetest and retestSell) or (allowRej and rejSell)
string longType = allowSweep and sweepBuy ? "SWEEP" : allowRetest and retestBuy ? "RETEST" : "REJECTION"
string shortType = allowSweep and sweepSell ? "SWEEP" : allowRetest and retestSell ? "RETEST" : "REJECTION"

float buySL = math.min(low, buyBase) - atr15 * slBufferATR
float sellSL = math.max(high, sellCap) + atr15 * slBufferATR
float riskBuy = close - buySL
float riskSell = sellSL - close
bool riskOKBuy = not na(riskBuy) and riskBuy > syminfo.mintick and riskBuy <= atr15 * maxStopATR
bool riskOKSell = not na(riskSell) and riskSell > syminfo.mintick and riskSell <= atr15 * maxStopATR
bool sessionOK = not useSession or not na(time(timeframe.period, sessionUTC, "Etc/UTC"))
var int lastSignal = na
bool cooldownOK = na(lastSignal) or bar_index - lastSignal >= cooldownBars
bool buySignal = barstate.isconfirmed and cooldownOK and sessionOK and bullTrend and snrBuyOK and longPattern and riskOKBuy
bool sellSignal = barstate.isconfirmed and cooldownOK and sessionOK and bearTrend and snrSellOK and shortPattern and riskOKSell
if buySignal or sellSignal
    lastSignal := bar_index

plotshape(buySignal, title = "BUY", text = "BUY", style = shape.labelup, location = location.belowbar, color = color.green, textcolor = color.white, size = size.tiny)
plotshape(sellSignal, title = "SELL", text = "SELL", style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, size = size.tiny)

float entryRef = close
float stopRef = buySignal ? buySL : sellSL
float targetRef = buySignal ? entryRef + rr * riskBuy : entryRef - rr * riskSell
string sideRef = buySignal ? "BUY" : "SELL"
string patternRef = buySignal ? longType : shortType
float stopDistance = math.abs(entryRef - stopRef)
float rawLots = stopDistance > 0 ? riskUSD / (stopDistance * ozPerLot) : na
float lots = not na(rawLots) ? math.floor(rawLots / lotStep) * lotStep : na
string lotsLabel = not na(lots) and lots >= minLot ? str.tostring(lots, "#.####") : "< minimum lot"

// ================= STRATEGY TESTER =================
// Catatan: process_orders_on_close = true untuk menyamakan entry dengan close sinyal.
// Ini dapat lebih optimistis daripada order riil pada awal candle berikutnya.
// Qty TradingView memakai unit kontrak, bukan lot CFD; syminfo.pointvalue harus dicek.
var int openedAt = na
float theoreticalQty = stopDistance > syminfo.mintick ? riskUSD / (stopDistance * syminfo.pointvalue) : na
bool canTrade = strategy.position_size == 0 and strategy.opentrades == 0
if canTrade and buySignal and not na(theoreticalQty) and theoreticalQty > 0
    strategy.entry("BUY", strategy.long, qty = theoreticalQty, comment = longType)
    strategy.exit("EXIT BUY", "BUY", stop = buySL, limit = targetRef)
    openedAt := bar_index
if canTrade and sellSignal and not na(theoreticalQty) and theoreticalQty > 0
    strategy.entry("SELL", strategy.short, qty = theoreticalQty, comment = shortType)
    strategy.exit("EXIT SELL", "SELL", stop = sellSL, limit = targetRef)
    openedAt := bar_index
if strategy.position_size != 0 and not na(openedAt) and bar_index - openedAt >= maxHoldBars
    strategy.close_all(comment = "TIME EXIT")
    openedAt := na
