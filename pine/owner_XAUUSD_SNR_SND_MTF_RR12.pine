//@version=6
indicator("XAUUSD | SNR H4 + SND H4/H1 | Entry M15 RR 1:2", overlay = true, max_lines_count = 30, max_labels_count = 30)

// ========= PENGATURAN =========
gTrend = "1. Trend H4 dan zona"
fastLen    = input.int(50, "EMA cepat H4", minval = 1, group = gTrend)
slowLen    = input.int(200, "EMA lambat H4", minval = 2, group = gTrend)
pivotLen   = input.int(3, "Pivot SNR H4 (kiri/kanan)", minval = 1, maxval = 20, group = gTrend)
impulseATR = input.float(0.8, "Minimum badan impulse (ATR TF)", minval = 0.1, step = 0.1, group = gTrend)
breakLen   = input.int(5, "Breakout struktur sebelum zona", minval = 2, maxval = 30, group = gTrend)
useSNR     = input.bool(true, "Syarat dekat SNR H4 saat entry", group = gTrend)
snrRadius  = input.float(1.0, "Jarak maksimal ke SNR (x ATR H4)", minval = 0.1, step = 0.1, group = gTrend)

gEntry = "2. Entry M15 dan SL/TP"
wickRatio   = input.float(0.60, "Posisi close candle rejection", minval = 0.5, maxval = 0.95, step = 0.05, group = gEntry)
slBuffer    = input.float(0.15, "Buffer SL (x ATR M15)", minval = 0.0, step = 0.05, group = gEntry)
maxSlATR    = input.float(4.0, "Maksimum jarak SL (x ATR M15)", minval = 0.5, step = 0.5, group = gEntry)
cooldown    = input.int(8, "Jeda minimal sinyal (candle M15)", minval = 0, group = gEntry)

// Perhitungan lot bersifat ESTIMASI; ukuran kontrak dan lot minimum bisa berbeda menurut broker.
gRisk = "3. Perkiraan ukuran posisi (akun USD)"
riskUSD     = input.float(10.0, "Risiko USD / trade", minval = 0.1, step = 1.0, group = gRisk)
ozPerLot    = input.float(100.0, "Ons per 1 lot - sesuaikan broker", minval = 0.01, group = gRisk)
minLot      = input.float(0.01, "Lot minimum broker", minval = 0.001, group = gRisk)
lotStep     = input.float(0.01, "Kelipatan lot broker", minval = 0.001, group = gRisk)

if timeframe.period != "15"
    runtime.error("Gunakan timeframe 15 menit (M15). Trend dan zona HTF diambil otomatis dari H4/H1.")

// ========= KALKULASI HTF =========
// Zona demand: candle bearish terakhir sebelum bullish displacement + breakout.
// Zona supply: candle bullish terakhir sebelum bearish displacement + breakdown.
// Semua nilai digeser [1] dalam konteks HTF sebelum request.security(lookahead_on),
// sehingga hanya memakai candle H4/H1 yang TELAH DITUTUP.
f_levels() =>
    atr = ta.atr(14)
    ph = ta.pivothigh(high, pivotLen, pivotLen)
    pl = ta.pivotlow(low, pivotLen, pivotLen)
    resistance = ta.valuewhen(not na(ph), ph, 0)
    support    = ta.valuewhen(not na(pl), pl, 0)

    bullImpulse = close > open and close[1] < open[1] and (close - open) >= atr * impulseATR and close > ta.highest(high, breakLen)[1]
    bearImpulse = close < open and close[1] > open[1] and (open - close) >= atr * impulseATR and close < ta.lowest(low, breakLen)[1]

    var float demandBottom = na
    var float demandTop = na
    var float supplyBottom = na
    var float supplyTop = na

    // Hilangkan zona yang sudah ditembus berdasarkan CLOSE timeframe asal.
    if not na(demandBottom) and close < demandBottom
        demandBottom := na
        demandTop := na
    if not na(supplyTop) and close > supplyTop
        supplyBottom := na
        supplyTop := na

    if bullImpulse
        demandBottom := low[1]
        demandTop := open[1]
    if bearImpulse
        supplyBottom := open[1]
        supplyTop := high[1]

    emaFast = ta.ema(close, fastLen)
    emaSlow = ta.ema(close, slowLen)
    [resistance[1], support[1], demandBottom[1], demandTop[1], supplyBottom[1], supplyTop[1], emaFast[1], emaSlow[1], close[1], atr[1]]

[r4, sup4, d4bot, d4top, s4bot, s4top, emaFast4, emaSlow4, close4, atr4] = request.security(syminfo.tickerid, "240", f_levels(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[_r1, _sup1, d1bot, d1top, s1bot, s1top, _emaFast1, _emaSlow1, _close1, _atr1] = request.security(syminfo.tickerid, "60", f_levels(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

bullishH4 = not na(emaSlow4) and emaFast4 > emaSlow4 and close4 > emaFast4
bearishH4 = not na(emaSlow4) and emaFast4 < emaSlow4 and close4 < emaFast4

// ========= GAMBAR SNR DAN SUPPLY/DEMAND =========
plot(r4, "Resistance H4", color = color.new(color.red, 15), linewidth = 2, style = plot.style_stepline)
plot(sup4, "Support H4", color = color.new(color.lime, 15), linewidth = 2, style = plot.style_stepline)

pd4b = plot(d4bot, "Demand H4 bawah", color = color.new(color.green, 38), style = plot.style_linebr)
pd4t = plot(d4top, "Demand H4 atas", color = color.new(color.green, 38), style = plot.style_linebr)
fill(pd4b, pd4t, color = color.new(color.green, 85), title = "Demand H4")
ps4b = plot(s4bot, "Supply H4 bawah", color = color.new(color.red, 38), style = plot.style_linebr)
ps4t = plot(s4top, "Supply H4 atas", color = color.new(color.red, 38), style = plot.style_linebr)
fill(ps4b, ps4t, color = color.new(color.red, 85), title = "Supply H4")

pd1b = plot(d1bot, "Demand H1 bawah", color = color.new(color.teal, 55), style = plot.style_linebr)
pd1t = plot(d1top, "Demand H1 atas", color = color.new(color.teal, 55), style = plot.style_linebr)
fill(pd1b, pd1t, color = color.new(color.teal, 91), title = "Demand H1")
ps1b = plot(s1bot, "Supply H1 bawah", color = color.new(color.orange, 50), style = plot.style_linebr)
ps1t = plot(s1top, "Supply H1 atas", color = color.new(color.orange, 50), style = plot.style_linebr)
fill(ps1b, ps1t, color = color.new(color.orange, 91), title = "Supply H1")

// ========= ENTRY M15 =========
atr15 = ta.atr(14)
range15 = math.max(high - low, syminfo.mintick)
rejectionBuy = close > open and close > close[1] and (close - low) / range15 >= wickRatio
rejectionSell = close < open and close < close[1] and (high - close) / range15 >= wickRatio

inD4 = not na(d4bot) and low <= d4top and high >= d4bot and close > d4bot
inD1 = not na(d1bot) and low <= d1top and high >= d1bot and close > d1bot
inS4 = not na(s4top) and high >= s4bot and low <= s4top and close < s4top
inS1 = not na(s1top) and high >= s1bot and low <= s1top and close < s1top

// Pilih zona valid dengan SL terdekat jika keduanya tersentuh.
chosenDBot = inD4 and inD1 ? math.max(d4bot, d1bot) : inD4 ? d4bot : inD1 ? d1bot : na
chosenSTop = inS4 and inS1 ? math.min(s4top, s1top) : inS4 ? s4top : inS1 ? s1top : na

nearSupport = not na(sup4) and close >= sup4 and close - sup4 <= atr4 * snrRadius
nearResistance = not na(r4) and close <= r4 and r4 - close <= atr4 * snrRadius
snrBuyOK = not useSNR or nearSupport
snrSellOK = not useSNR or nearResistance

slBuy = math.min(chosenDBot, low) - atr15 * slBuffer
slSell = math.max(chosenSTop, high) + atr15 * slBuffer
riskBuy = close - slBuy
riskSell = slSell - close
validRiskBuy = not na(riskBuy) and riskBuy > syminfo.mintick and riskBuy <= atr15 * maxSlATR
validRiskSell = not na(riskSell) and riskSell > syminfo.mintick and riskSell <= atr15 * maxSlATR

var int lastSignalBar = na
canSignal = na(lastSignalBar) or bar_index - lastSignalBar >= cooldown
buySignal = barstate.isconfirmed and canSignal and bullishH4 and (inD4 or inD1) and snrBuyOK and rejectionBuy and validRiskBuy
sellSignal = barstate.isconfirmed and canSignal and bearishH4 and (inS4 or inS1) and snrSellOK and rejectionSell and validRiskSell

plotshape(buySignal, title = "BUY", text = "BUY", style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.white, size = size.tiny)
plotshape(sellSignal, title = "SELL", text = "SELL", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, size = size.tiny)

// ========= ENTRY / SL / TP (SINYAL TERAKHIR) =========
var line lEntry = na
var line lSL = na
var line lTP = na
var label infoLabel = na

if buySignal or sellSignal
    lastSignalBar := bar_index
    if not na(lEntry)
        line.delete(lEntry)
    if not na(lSL)
        line.delete(lSL)
    if not na(lTP)
        line.delete(lTP)
    if not na(infoLabel)
        label.delete(infoLabel)

    entryPrice = close // Harga referensi setelah candle sinyal M15 selesai.
    stopPrice = buySignal ? slBuy : slSell
    stopDistance = math.abs(entryPrice - stopPrice)
    targetPrice = buySignal ? entryPrice + 2.0 * stopDistance : entryPrice - 2.0 * stopDistance
    rawLots = riskUSD / (stopDistance * ozPerLot)
    estimatedLots = math.floor(rawLots / lotStep) * lotStep
    lotText = estimatedLots >= minLot ? str.tostring(estimatedLots, "#.###") : "< lot minimum"
    side = buySignal ? "BUY" : "SELL"
    directionColor = buySignal ? color.green : color.red

    lEntry := line.new(bar_index, entryPrice, bar_index + 1, entryPrice, extend = extend.right, color = color.blue, width = 2)
    lSL := line.new(bar_index, stopPrice, bar_index + 1, stopPrice, extend = extend.right, color = color.red, style = line.style_dashed, width = 2)
    lTP := line.new(bar_index, targetPrice, bar_index + 1, targetPrice, extend = extend.right, color = color.green, style = line.style_dashed, width = 2)
    infoText = side + " | H4 " + (buySignal ? "BULLISH" : "BEARISH") + "\nEntry: " + str.tostring(entryPrice, format.mintick) + "\nSL: " + str.tostring(stopPrice, format.mintick) + "\nTP: " + str.tostring(targetPrice, format.mintick) + " (1:2)" + "\nEstimasi lot ($" + str.tostring(riskUSD, "#.##") + " risk): " + lotText
    infoLabel := label.new(bar_index, buySignal ? low : high, infoText, style = buySignal ? label.style_label_up : label.style_label_down, color = directionColor, textcolor = color.white, size = size.small)

    // Gunakan "Any alert() function call" di menu TradingView untuk pesan lengkap.
    alert(side + " " + syminfo.ticker + " M15 | H4 " + (buySignal ? "BULLISH" : "BEARISH") + " | Entry " + str.tostring(entryPrice, format.mintick) + " | SL " + str.tostring(stopPrice, format.mintick) + " | TP " + str.tostring(targetPrice, format.mintick) + " | Est.lot " + lotText + " | RR 1:2", alert.freq_once_per_bar_close)

alertcondition(buySignal, title = "XAUUSD BUY", message = "BUY {{ticker}} pada M15. Lihat indikator untuk Entry/SL/TP.")
alertcondition(sellSignal, title = "XAUUSD SELL", message = "SELL {{ticker}} pada M15. Lihat indikator untuk Entry/SL/TP.")

var table status = table.new(position.top_right, 1, 2, border_width = 1)
if barstate.islast
    table.cell(status, 0, 0, "TREND H4", bgcolor = color.new(color.black, 20), text_color = color.white)
    table.cell(status, 0, 1, bullishH4 ? "BULLISH / BUY" : bearishH4 ? "BEARISH / SELL" : "NETRAL / TUNGGU", bgcolor = bullishH4 ? color.new(color.green, 10) : bearishH4 ? color.new(color.red, 10) : color.gray, text_color = color.white)
