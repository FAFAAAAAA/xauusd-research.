{
  "name": "nobar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nonton bareng 2 orang: host membagikan tab Chrome lewat WebRTC P2P, penonton menonton di HP.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p web/tsconfig.json && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vite build && node tests/e2e/watch-flow.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "typescript": "~5.9.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  }
}
